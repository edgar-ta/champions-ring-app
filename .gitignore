# Miscellaneous
/app/*.class
/app/*.log
/app/*.pyc
/app/*.swp
/app/.DS_Store
/app/.atom/
/app/.build/
/app/.buildlog/
/app/.history
/app/.svn/
/app/.swiftpm/
/app/migrate_working_dir/

# IntelliJ related
/app/*.iml
/app/*.ipr
/app/*.iws
/app/.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
/app/android/.kotlin/
/app/**/doc/api/
/app/**/ios/Flutter/.last_build_id
/app/.dart_tool/
/app/.flutter-plugins-dependencies
/app/.pub-cache/
/app/.pub/
/app/build/
/app/coverage/

# Symbolication related
/app/app.*.symbols

# Obfuscation related
/app/app.*.map.json

# Android Studio will place build artifacts here
/app/android/app/debug
/app/android/app/profile
/app/android/app/release

# Widget Preview related
/app/.widget_preview/

/docs/**/*.docx
/docs/**/*.dotx
/docs/**/*.pdf
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.m4a
/docs/**/*.mp4
/docs/**/*.svg
/docs/**/*.lnk
/docs/**/*.tmp
.env

# Backend (formerly backend/.gitignore)
/backend/**/logs
/backend/**/*.log
/backend/**/npm-debug.log*
/backend/**/yarn-debug.log*
/backend/**/yarn-error.log*
/backend/**/firebase-debug.log*
/backend/**/firebase-debug.*.log*

# Firebase cache and generated config
/backend/**/.firebase/
# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# /backend/.firebaserc

# Runtime data
/backend/**/pids
/backend/**/*.pid
/backend/**/*.seed
/backend/**/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
/backend/**/lib-cov

# Coverage directory used by tools like istanbul
/backend/**/coverage

# nyc test coverage
/backend/**/.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
/backend/**/.grunt

# Bower dependency directory (https://bower.io/)
/backend/**/bower_components/

# node-waf configuration
/backend/**/.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
/backend/**/build/Release

# Dependency directories
/backend/**/node_modules/

# Optional npm cache directory
/backend/**/.npm/

# Optional eslint cache
/backend/**/.eslintcache

# Optional REPL history
/backend/**/.node_repl_history

# Output of 'npm pack'
/backend/**/*.tgz

# Yarn Integrity file
/backend/**/.yarn-integrity

# dataconnect generated files
/backend/**/.dataconnect

# Backend functions
/backend/functions/**/*.local
