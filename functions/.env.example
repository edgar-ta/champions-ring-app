# Copia este archivo como functions/.env (no lo subas con secretos).
# Los secretos NO van aquí; se configuran con:
#   firebase functions:secrets:set MP_ACCESS_TOKEN
#   firebase functions:secrets:set MP_WEBHOOK_SECRET

# Base de Firestore. El proyecto usa una base llamada "default"
# (sin paréntesis); usa "(default)" solo si migras a la base por defecto.
# FIRESTORE_DATABASE_ID=default

# "true" para devolver sandbox_init_point (pruebas con credenciales TEST-).
# MP_USE_SANDBOX=false

# Opcionales: por defecto apuntan a las funciones desplegadas.
# MP_NOTIFICATION_URL=https://us-central1-champions-ring-app.cloudfunctions.net/mercadoPagoWebhook?source_news=webhooks
# PAYMENT_RETURN_URL=https://us-central1-champions-ring-app.cloudfunctions.net/paymentReturn
